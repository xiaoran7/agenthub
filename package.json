{
  "name": "agent-pulse",
  "private": true,
  "version": "2.0.5",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "format": "prettier --write package.json tsconfig.base.json packages services apps",
    "format:check": "prettier --check package.json tsconfig.base.json packages services apps",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "prettier": "3.9.6"
  },
  "overrides": {
    "postcss": "^8.5.18",
    "sharp": "^0.35.0"
  },
  "engines": {
    "node": ">=22"
  }
}
