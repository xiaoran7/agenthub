{
  "name": "agent-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "format": "prettier --write package.json tsconfig.base.json packages services",
    "format:check": "prettier --check package.json tsconfig.base.json packages services",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "prettier": "3.9.6"
  },
  "engines": {
    "node": ">=22"
  }
}
