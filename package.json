{
  "name": "agenthub",
  "private": true,
  "version": "2.4.93",
  "description": "Remote Web console & session manager for Claude Code and OpenAI Codex. Continue sessions anywhere via browser or mobile PWA.",
  "author": "WANGUI TANG",
  "license": "MIT",
  "homepage": "https://github.com/xiaoran7/agenthub#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaoran7/agenthub.git"
  },
  "bugs": {
    "url": "https://github.com/xiaoran7/agenthub/issues"
  },
  "keywords": [
    "claude-code",
    "codex",
    "openai-codex",
    "ai-agent",
    "agent-runner",
    "session-manager",
    "remote-control",
    "web-ui",
    "dashboard",
    "self-hosted",
    "pwa",
    "developer-tools",
    "rust",
    "typescript"
  ],
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "format": "prettier --write package.json tsconfig.base.json packages services apps",
    "format:check": "prettier --check package.json tsconfig.base.json packages services apps",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "prettier": "3.9.6"
  },
  "overrides": {
    "postcss": "^8.5.18",
    "sharp": "^0.35.0"
  },
  "engines": {
    "node": ">=22"
  }
}
