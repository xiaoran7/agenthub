# 将域名和证书路径替换为真实值后启用。
#
# 外层反代只做一件事：把流量交给 Web 前门（127.0.0.1:3000 上的 nginx）。
# 同源 API 代理、会话 Cookie 白名单与服务端令牌注入全部由 Web 前门内部完成
# （deploy/nginx/agenthub-web.conf.template），外层不要重复实现，
# 否则两层凭据语义会漂移。

map $http_upgrade $agenthub_outer_connection {
    default upgrade;
    ""      "";
}

server {
    listen 80;
    server_name agent.example.com;

    location ^~ /.well-known/acme-challenge/ {
        allow all;
        root /usr/share/nginx/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name agent.example.com;

    ssl_certificate     /etc/letsencrypt/live/agent.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/agent.example.com/privkey.pem;
    ssl_protocols TLSv1.3 TLSv1.2;

    client_max_body_size 12m;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-User-Id "";
    proxy_set_header Forwarded "";
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $agenthub_outer_connection;

    # 网关变更流（SSE）：整条链路上不能有缓冲层。
    location /v1/stream {
        proxy_pass http://127.0.0.1:3000;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Accel-Buffering no always;
    }

    # 远程会话 WebSocket：保留长连接与协议升级
    location ^~ /v3/remote/ws {
        proxy_pass http://127.0.0.1:3000;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    # 远程会话流（SSE）
    location ^~ /v3/remote/stream {
        proxy_pass http://127.0.0.1:3000;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Accel-Buffering no always;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
    }
}
