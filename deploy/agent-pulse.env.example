# 生产环境变量示例。复制为服务器上的 /etc/agent-pulse/agent-pulse.env，
# 不要把真实值提交到仓库。

NODE_ENV=production

# API 只监听本机；外部流量由 Nginx/Caddy 终止 TLS 后转给 Web。
HOST=127.0.0.1
PORT=3001
# 生产环境必须使用持久化 PostgreSQL，不能省略。
AGENT_PLATFORM_DATABASE_URL=postgresql://agent_pulse:replace-with-password@127.0.0.1:5432/agent_pulse

# 生产必填。使用 32 字节以上随机值的 base64url 编码，对登录限流 scope 做 HMAC。
AGENT_PULSE_LOGIN_RATE_LIMIT_SECRET=replace-with-base64url-secret

# Web 服务端访问本机 API；浏览器始终只访问同源 /v1 代理。
GATEWAY_ORIGIN=http://127.0.0.1:3001

# 邮箱验证三项必须一起配置；不配置时本地注册可用，但不会强制邮箱验证。
# AGENT_PULSE_PUBLIC_BASE_URL=https://pulse.example.com
# AGENT_PULSE_EMAIL_ENDPOINT=https://mail-adapter.example.com/v1/messages
# AGENT_PULSE_EMAIL_TOKEN=replace-with-at-least-32-characters

# 账单适配器可选。配置后启用 /v1/billing/events 签名事件入口。
# AGENT_PULSE_BILLING_WEBHOOK_SECRET=replace-with-base64url-secret

# 新部署默认使用注册/登录与 HttpOnly Cookie，不需要全局 owner/token。
# 仅迁移旧个人部署时才同时配置下面三个兼容变量；新部署保持注释。
# AGENT_PLATFORM_OWNER_ID=legacy-owner
# AGENT_PLATFORM_ACCESS_TOKEN=replace-with-a-random-token
# GATEWAY_ACCESS_TOKEN=replace-with-the-same-random-token

# 如需 Web Push，再同时配置下面三个值；不需要时保持注释。
# AGENT_PLATFORM_VAPID_PUBLIC_KEY=
# AGENT_PLATFORM_VAPID_PRIVATE_KEY=
# AGENT_PLATFORM_VAPID_SUBJECT=mailto:ops@example.com
