# 生产环境变量示例。复制为服务器上的 /etc/agent-pulse/agent-pulse.env，
# 不要把真实值提交到仓库。

NODE_ENV=production

# API 只监听本机；外部流量由 Nginx/Caddy 终止 TLS 后转给 Web。
HOST=127.0.0.1
PORT=3001
AGENT_PLATFORM_OWNER_ID=replace-with-owner-id

# 使用至少 32 字节、且不含空白字符的随机值；API 和 Web 必须完全一致。
# 生成示例：node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AGENT_PLATFORM_ACCESS_TOKEN=replace-with-a-random-token
GATEWAY_ACCESS_TOKEN=replace-with-the-same-random-token

# 生产环境必须使用持久化 PostgreSQL，不能省略。
AGENT_PLATFORM_DATABASE_URL=postgresql://agent_pulse:replace-with-password@127.0.0.1:5432/agent_pulse

# Web 服务端访问本机 API；浏览器始终只访问同源 /v1 代理。
GATEWAY_ORIGIN=http://127.0.0.1:3001

# 如需 Web Push，再同时配置下面三个值；不需要时保持注释。
# AGENT_PLATFORM_VAPID_PUBLIC_KEY=
# AGENT_PLATFORM_VAPID_PRIVATE_KEY=
# AGENT_PLATFORM_VAPID_SUBJECT=mailto:ops@example.com
