# Docker Compose 生产环境变量示例。
# PostgreSQL 由 1Panel 应用商店管理；复制为 deploy/docker.env 后填写真实值。
# 不要提交 docker.env。

AGENT_PLATFORM_OWNER_ID=replace-with-owner-id
AGENT_PLATFORM_ACCESS_TOKEN=replace-with-a-random-token

# API 使用 host network，通过本机 5432 访问 1Panel PostgreSQL。
AGENT_PLATFORM_DATABASE_URL=postgresql://agent_pulse:replace-with-a-long-random-password@127.0.0.1:5432/agent_pulse
