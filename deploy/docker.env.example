# Docker Compose 生产环境变量示例。
# PostgreSQL 由 1Panel 应用商店管理；复制为 deploy/docker.env 后填写真实值。
# 不要提交 docker.env。

# API 使用 host network，通过本机 5432 访问 1Panel PostgreSQL。
AGENT_PLATFORM_DATABASE_URL=postgresql://agent_pulse:replace-with-a-long-random-password@127.0.0.1:5432/agent_pulse
AGENT_PULSE_LOGIN_RATE_LIMIT_SECRET=replace-with-base64url-secret

# 邮箱验证三项必须一起配置。
# AGENT_PULSE_PUBLIC_BASE_URL=https://platform.example.com
# AGENT_PULSE_EMAIL_ENDPOINT=https://mail-adapter.example.com/v1/messages
# AGENT_PULSE_EMAIL_TOKEN=replace-with-at-least-32-characters

# AGENT_PULSE_BILLING_WEBHOOK_SECRET=replace-with-base64url-secret

# Stripe Checkout and customer portal are optional. Set all five values together.
# AGENT_PULSE_PUBLIC_BASE_URL=https://platform.example.com
# AGENT_PULSE_STRIPE_SECRET_KEY=sk_live_replace-me
# AGENT_PULSE_STRIPE_WEBHOOK_SECRET=whsec_replace-me
# AGENT_PULSE_STRIPE_PRICE_PRO=price_replace-pro
# AGENT_PULSE_STRIPE_PRICE_TEAM=price_replace-team

# 新部署使用账户 Cookie；不要设置全局 AGENT_PLATFORM_ACCESS_TOKEN。
