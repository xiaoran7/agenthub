# AgentHub 纯自建极简环境变量示例
# 复制为 deploy/docker.env 并填入随机密钥即可。
# 无需 PostgreSQL，无需 Stripe，无需邮箱配置，单机 SQLite 存储。
# 默认使用账号注册/登录与 HttpOnly Cookie 会话鉴权（首次启动通过向导创建管理员）。

# 登录限流 scope 的 HMAC 密钥（必填，至少 32 字节随机 base64url）：
# 可用 `openssl rand -base64 32 | tr '+/' '-_' | tr -d '='` 生成
AGENT_PULSE_LOGIN_RATE_LIMIT_SECRET=replace-with-at-least-32-random-base64url-bytes

# 局域网 HTTP 访问保持 false；前端若经 HTTPS 反向代理暴露，改为 true 启用 __Host- 安全 Cookie
AGENT_PULSE_COOKIE_SECURE=false

# 仅在确需无账号单用户 Bearer 兼容模式时才取消注释并设置随机密钥：
# GATEWAY_ACCESS_TOKEN=replace-with-random-32-byte-token
# AGENT_PLATFORM_OWNER_ID=admin
