# AgentHub 纯自建极简环境变量示例
# 复制为 deploy/docker.env 并填入随机密钥后，执行：
#   docker compose --env-file deploy/docker.env -f deploy/docker-compose.selfhost.yml up -d --build
# 无需 PostgreSQL，无需 Stripe，无需邮箱配置，单机 SQLite 存储（通过命名卷 agenthub_data 持久化）。
# 默认使用账号注册/登录与 HttpOnly Cookie 会话鉴权（首次启动通过向导创建管理员）。

# 登录限流 scope 的 HMAC 密钥（必填，至少 32 字节随机 base64url）：
# 可用 `openssl rand -base64 32 | tr '+/' '-_' | tr -d '='` 生成
AGENT_PULSE_LOGIN_RATE_LIMIT_SECRET=replace-with-at-least-32-random-base64url-bytes

# 局域网 HTTP 访问保持 false；前端若经 HTTPS 反向代理暴露，改为 true 启用 __Host- 安全 Cookie
AGENT_PULSE_COOKIE_SECURE=false

# 安全警告：仅在确需无账号单用户 Bearer 兼容模式时才同时取消注释以下三项。
# 启用后 Web 容器会自动向所有代理请求注入 Bearer 令牌，任何能访问 3000 端口的客户端都将直接获得完整控制权！
# 若启用此模式，务必把 docker-compose.selfhost.yml 中的端口映射改为 "127.0.0.1:3000:3000"，
# 并仅通过带独立鉴权的外层反向代理或私有 VPN（如 Tailscale / WireGuard）访问。
# 确保 AGENT_PLATFORM_ACCESS_TOKEN 与 GATEWAY_ACCESS_TOKEN 使用相同的随机密钥：
# AGENT_PLATFORM_OWNER_ID=admin
# AGENT_PLATFORM_ACCESS_TOKEN=replace-with-random-32-byte-token
# GATEWAY_ACCESS_TOKEN=replace-with-random-32-byte-token
