{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentPulse",
  "version": "0.1.0",
  "identifier": "xyz.tannerlab.agentpulse",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AgentPulse",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Claude Code 与 Codex 本地会话监控",
    "longDescription": "登录一次，自动发现并安全同步本机 Claude Code 与 Codex 会话状态。"
  }
}
