{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentHub",
  "version": "2.0.6",
  "identifier": "xyz.tannerlab.agenthub",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AgentHub",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "跨平台 Coding Agent 统一监控与本地集成中心",
    "longDescription": "登录一次，自动发现并安全同步本机 Claude Code、Codex、Antigravity 与 Grok Build 会话状态。"
  }
}
