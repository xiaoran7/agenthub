{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentHub",
  "version": "2.4.27",
  "identifier": "xyz.tannerlab.agenthub",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AgentHub",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "decorations": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "\u539f\u751f Coding Agent \u8fdc\u7a0b\u4f1a\u8bdd\u5165\u53e3",
    "longDescription": "\u8fde\u63a5\u672c\u673a Codex\uff0c\u5728\u684c\u9762\u3001\u7f51\u9875\u548c\u624b\u673a\u63a5\u7eed\u540c\u4e00\u539f\u751f\u4f1a\u8bdd\uff0c\u67e5\u770b\u8f93\u51fa\u3001\u5904\u7406\u5ba1\u6279\u4e0e\u4e2d\u65ad\u3002"
  }
}
