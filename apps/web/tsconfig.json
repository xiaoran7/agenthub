{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "paths": {
      "@agent-pulse/contracts": ["../../packages/contracts/src/index.ts"],
      "@agent-pulse/contracts/remote": [
        "../../packages/contracts/src/remote.ts"
      ],
      "@agent-pulse/contracts/account": [
        "../../packages/contracts/src/account.ts"
      ],
      "@agent-pulse/contracts/avatar-rules": [
        "../../packages/contracts/src/avatar-rules.ts"
      ]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
